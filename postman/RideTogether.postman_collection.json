            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"Delhi\",\n  \"destination\": \"Jaipur\",\n  \"departureTime\": \"2027-01-15T08:00:00.000Z\",\n  \"fare\": 450,\n  \"totalSeats\": 3\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.ride) pm.collectionVariables.set('rideId', d.ride._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Search rides",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/rides?source=delhi&destination=jaipur&seats=1&maxFare=1000&sort=fare_asc&page=1&limit=6",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rides?source=delhi&destination=jaipur&seats=1&maxFare=1000&sort=fare_asc&page=1&limit=6"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "My rides (driver)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
